# Quellight G1 — environment variables
#
# No credentials are required for the deterministic walking slice (QD-02):
# reasoning uses the VICT/Mastra deterministic offline fixture.
# The live provider path (GLM-5.3-flash) is NOT implemented at G1 and was
# recorded as `NOT RUN — no authorized configured credential available`.
# Never commit real credential values or secrets of any kind.

# Path to the Python 3.12 interpreter with cognee[gliner]==1.6.1 installed
# (required for the real VICT-Cognee worker; without it Quellight degrades
# truthfully and answers without durable knowledge retrieval).
QUOLLIGHT_COGNEE_PYTHON=C:/path/to/cognee-venv/Scripts/python.exe

# Root for disposable app runtime state (Mastra store + Cognee store).
# Defaults to <repo>/quellight/run. The Cognee store persists across
# restarts — that is the G1 durable-knowledge store.
# QUOLLIGHT_RUN_ROOT=C:/absolute/path/to/run-root

# Bounded controlled-failure knob for G1 failure-path verification (W4):
# none (default) | retrieval | model
QUOLLIGHT_FAULT=none

# Set to 1 to boot without the knowledge path (degraded mode demo).
# QUOLLIGHT_COGNEE_DISABLED=1